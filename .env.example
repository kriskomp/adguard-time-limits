# Copy to /etc/netguard/netguard.env and fill in. Never commit the real file.
ADGUARD_URL=http://192.168.1.2:3000
ADGUARD_USER=admin
ADGUARD_PASS=change_me

# Home Assistant notifications (optional; leave HA_URL/HA_TOKEN empty to disable)
HA_URL=http://homeassistant.local:8123
HA_TOKEN=paste_long_lived_access_token
HA_NOTIFY_SERVICE=notify.notify

# rule (default): reply with an instant refusal via an AdGuard custom filtering rule
# disallow: legacy mode, uses AdGuard "disallowed clients" (requests are silently dropped)
BLOCK_MODE=rule

TICK_SECONDS=30
NOTIFY_EVERY_MIN=30
RECONCILE_EVERY_TICKS=40
